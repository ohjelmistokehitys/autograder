{
    "name": "Example test suite",
    "description": "This test suite demonstrates key capabilities of the autograder tool.",
    "defaultTimeout": "1m",
    "tests": [
        {
            "name": "Test 1",
            "description": "This test checks if the autograder tool can run a simple command",
            "score": 10,
            "$run": "echo test 1",
            "contains": "test 1",
            "timeout": "5s"
        },
        {
            "name": "Test 2",
            "description": "This test checks if the autograder tool can run a command with input",
            "score": 20,
            "$run": "cat",
            "input": "hello world",
            "contains": [
                "hello",
                "world"
            ],
            "notContains": "example",
            "timeout": 5
        },
        {
            "name": "Test 3",
            "description": "This test checks if the autograder tool can run multiple commands and lifecycle hooks",
            "score": 20,
            "$setup": [
                "echo Setting up...",
                "echo hello > demo.txt",
                "echo world >> demo.txt"
            ],
            "$run": [
                "mv demo.txt demo2.txt",
                "cat demo2.txt"
            ],
            "contains": [
                "hello",
                "world"
            ],
            "notContains": [
                "example",
                "test"
            ],
            "regex": [
                "^hello\\s+world\\s+$"
            ],
            "$teardown": [
                "echo Tearing down...",
                "rm demo2.txt"
            ],
            "timeout": 5
        },
        {
            "name": "Test 4",
            "description": "This test fails intentionally to demonstrate the autograder's failure handling",
            "score": 20,
            "$run": "cat",
            "input": "hello world",
            "contains": [
                "example"
            ],
            "timeout": 5,
            "skipRemainingOnFailure": true
        },
        {
            "name": "Test 5",
            "description": "This test is skipped because the previous test failed and skipRemainingOnFailure was set to true",
            "score": 20,
            "$run": "echo test 5",
            "contains": "test 5",
            "timeout": 5
        }
    ]
}
