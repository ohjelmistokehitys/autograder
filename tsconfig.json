{
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "noEmit": true,
        "declaration": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitAny": true,
        "strict": true,
        "skipLibCheck": true,
        "lib": [
            "esnext"
        ],
        "types": [
            "node"
        ],
        "erasableSyntaxOnly": true,
        "rewriteRelativeImportExtensions": true,
        "verbatimModuleSyntax": true
    },
}
