{
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "esModuleInterop": true,
        "rootDir": "src",
        "outDir": "build",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "lib": [
            "esnext"
        ],
        "types": [
            "node"
        ],
        "erasableSyntaxOnly": true,
        "rewriteRelativeImportExtensions": true,
        "verbatimModuleSyntax": true
    },
}
